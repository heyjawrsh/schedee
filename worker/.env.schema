# Schedee Worker environment.
# Values for local development live in a gitignored .env.local. The maintainer's points at
# 1Password; a fork sets its own Google OAuth client there.
# @plugin(@varlock/1password-plugin)
# @initOp(allowAppAuth=true)
# @defaultRequired=true
# @defaultSensitive=false
# ---

# Google "Web application" OAuth client ID.
GOOGLE_WEB_CLIENT_ID=

# Google "Web application" OAuth client secret. Only the Worker ever sees it.
# @sensitive
GOOGLE_WEB_CLIENT_SECRET=

# The app origin allowed to call the Worker and receive the sign-in result.
APP_ORIGIN=http://localhost:5173
