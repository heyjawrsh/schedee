# Schedee desktop build environment.
# Read at compile time by the Rust shell. Values for local development live in a gitignored
# .env.local; the maintainer's points at 1Password. Without them the app builds, but Google
# sign-in reports "not_configured".
# @plugin(@varlock/1password-plugin)
# @initOp(allowAppAuth=true)
# @defaultRequired=false
# @defaultSensitive=false
# ---

# Google "Desktop app" OAuth client ID.
GOOGLE_DESKTOP_CLIENT_ID=

# Google "Desktop app" OAuth client secret. Google treats installed-app secrets as public, so it
# ships inside the binary, but keep it out of the repo.
# @sensitive
GOOGLE_DESKTOP_CLIENT_SECRET=
