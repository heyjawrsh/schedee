{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Schedee",
	"version": "0.12.0",
	"identifier": "ee.sched.app",
	"build": {
		"frontendDist": "../../web/dist",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "pnpm --filter @schedee/web dev",
		"beforeBuildCommand": "pnpm --filter @schedee/web build"
	},
	"app": {
		"windows": [
			{
				"title": "Schedee",
				"width": 1440,
				"height": 900,
				"minWidth": 800,
				"minHeight": 560,
				"resizable": true,
				"fullscreen": false
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
